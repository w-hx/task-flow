{
  "name": "task-flow",
  "version": "1.0.0",
  "description": "Mac OS 菜单栏时间表应用",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.taskflow.app",
    "productName": "TaskFlow",
    "files": [
      "**/*",
      "!dist/**/*",
      "!**/*.ts",
      "!*.map",
      "!package-lock.json",
      "!.trae/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "directories": {
      "output": "dist"
    }
  }
}
